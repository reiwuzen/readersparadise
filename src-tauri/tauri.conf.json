{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReadersParadise",
  "version": "0.1.0",
  "identifier": "com.rei.readersparadise",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "ReadersParadise",
        "width": 800,
        "height": 600,
        "minHeight": 600,
        "minWidth": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "webview-create",
          "description": "Allow certain webviews to create new webview windows",
          "permissions": ["core:webview:allow-create-webview-window","core:window:allow-close","core:window:allow-set-size","core:window:allow-set-position","core:window:allow-show","core:window:default","core:event:allow-listen", "core:event:default", "fs:allow-read-file", "fs:default" , "core:webview:allow-webview-show","core:webview:allow-set-webview-focus","core:webview:allow-set-webview-size","core:webview:allow-set-webview-position" ],
          "webviews": ["*"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
