        },
        "status_selector": {
          "selector": "div.y6x11p span.dt"
        },
        "type_selector": {
          "selector": "div.y6x11p span.dt"
        },
        "bookmarks_selector": {
          "selector": "div.y6x11p span.dt"
        },
        "created_selector": {
          "selector": "div.y6x11p span.dt"
        },
        "update_selector": {
          "selector": "div.y6x11p span.dt"
        },
        "title_selector": {
          "selector": "h1.mt-0.mb-6.fs-20",
